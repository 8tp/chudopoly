# Comma-separated extra browser origins allowed to open WebSockets in production.
# Same-origin browser connections are always accepted.
ALLOWED_ORIGINS=https://example.com

# Optional GIF search integration.
GIPHY_KEY=

# Hosting platforms normally inject this value.
PORT=3000

# Where finished-game records land (one JSONL line per game, server/gamelog.js).
# On Railway SET THIS TO THE VOLUME'S MOUNT PATH (e.g. /data/gamelog): the
# default ./logs directory is ephemeral there and every redeploy erases it.
# Volumes mount at runtime only; the server probes writability at boot and
# falls back to ./logs WITH A STARTUP WARNING if the path cannot be written.
CHUD_GAME_LOG_DIR=

# How many closed, gzipped archives the rotation ring keeps. Retention math,
# measured on the real log (DESIGN.md §3.1): a real game averages 61.5KB raw,
# gzip lands at 8.8%, and the live file rotates at 32MB — so the DEFAULT of 5
# archives retains only ~192MB raw ≈ ~3,200 real games, which at any real
# traffic is weeks, not history. 200 ≈ 6.4GB raw ≈ ~760MB actually on disk
# ≈ ~100k games; size the volume accordingly (1GB ≈ 17k games raw-equivalent,
# far more once archives are gzipped).
CHUD_GAME_LOG_ARCHIVES=200
