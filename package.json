{
  "name": "chudopoly",
  "version": "1.0.0",
  "description": "Air Force themed Monopoly Deal card game - multiplayer web edition",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check": "node scripts/check-syntax.js",
    "test": "node --test",
    "verify": "node tools/verify.mjs",
    "serve": "node tools/serve.mjs",
    "verify:fast": "node tools/verify.mjs --fast",
    "tool:assets": "node tools/checkAssets.mjs",
    "tool:client": "node tools/checkClient.mjs",
    "tool:server": "node tools/checkServer.mjs",
    "tool:record": "node tools/record.mjs",
    "tool:simbalance": "node tools/simbalance.mjs",
    "tool:playtest": "node tools/playtest.mjs",
    "tool:touchtest": "node tools/touchtest.mjs",
    "tool:tabaway": "node tools/tabaway.mjs",
    "tool:screenshot": "node tools/screenshot.mjs",
    "tool:audiotest": "node tools/audiotest.mjs",
    "tool:contrast": "node tools/checkContrast.mjs",
    "tool:grayscale": "node tools/grayscale.mjs",
    "tool:prove": "node tools/checkContrast.mjs --prove; node tools/grayscale.mjs --prove; node tools/touchtest.mjs --prove; node tools/screenshot.mjs --prove-theme"
  },
  "engines": {
    "node": ">=20 <25"
  },
  "dependencies": {
    "express": "^4.22.2",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "playwright": "^1.56.0",
    "pngjs": "^7.0.0"
  }
}
